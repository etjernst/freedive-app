# Example only, not an active workflow (the .example suffix keeps GitHub
# Actions from picking it up). This belongs in a separate repo named
# winnow-seals, whose GitHub Pages URL is https://etjernst.github.io/winnow-seals/.
# To activate it there: copy this file to winnow-seals/.github/workflows/deploy.yml
# (dropping the .example suffix).

name: Deploy Winnow Seals to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

# Allow one concurrent deployment; cancel in-progress runs on a new push.
concurrency:
  group: pages
  cancel-in-progress: true

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      # Pulls the app source from the public freedive-app repo, not this one.
      - uses: actions/checkout@v4
        with:
          repository: etjernst/freedive-app
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run build:seals
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
